# VicoHome credentials (from your VicoHome/HeaPets app account)
VICOHOME_EMAIL=your_email@example.com
VICOHOME_PASSWORD=your_password

# MQTT broker (same as BirdNET-Go)
MQTT_BROKER=192.168.1.148
MQTT_PORT=1883
MQTT_USERNAME=birdnet
MQTT_PASSWORD=changeme

# Polling interval in seconds
POLL_INTERVAL=60
